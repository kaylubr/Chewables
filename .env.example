# Runtime environment: production, development, or testing (set via cross-env in npm scripts).
NODE_ENV=development

DATABASE_URL=postgresql://chewables:chewables@localhost:5434/chewables

S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=chewables
S3_SECRET_KEY=chewables-secret
S3_BUCKET=chewables
S3_REGION=us-east-1

AUTH_SECRET=dev-only-change-me-0123456789abcdef0123456789abcdef
# Session lifetime in seconds (default 7 days = 604800). Better-Auth uses this for both
# the session cookie and its cache.
SESSION_EXPIRES_IN=604800

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Where Better-Auth redirects the user after a provider callback.
OAUTH_REDIRECT_BASE=http://localhost:5173
# The externally reachable backend base URL (used to build the callback URL).
BACKEND_BASE_URL=http://localhost:8000

# Allowed CORS origin in non-production (dev SPA). Prod is same-origin behind Express.
CORS_ORIGIN=http://localhost:5173
