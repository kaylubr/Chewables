{
  "name": "chewable",
  "private": true,
  "version": "0.1.0",
  "description": "Chewables photobooth web app, monorepo for backend (Express) and frontend (SvelteKit)",
  "workspaces": [
    "src/core",
    "src/shared",
    "src/ui"
  ],
  "scripts": {
    "dev": "cross-env NODE_ENV=development tsx watch src/core/index.ts",
    "build": "npm run build -w @chewable/core && npm run build -w @chewable/ui",
    "start": "cross-env NODE_ENV=production node dist/core/index.js",
    "test": "cross-env NODE_ENV=testing vitest run --config src/core/vitest.config.ts",
    "test:watch": "cross-env NODE_ENV=testing vitest --config src/core/vitest.config.ts",
    "test:ui": "npm test -w @chewable/ui",
    "check": "tsc --noEmit",
    "format": "biome check --write .",
    "format:check": "biome check .",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "cross-env": "^7.0.3",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vitest": "^2.1.5"
  },
  "dependencies": {
    "@noble/ciphers": "^2.4.0",
    "defu": "^6.1.7"
  }
}
